# Valet — Local Development Configuration
# Copy this to .env and fill in your keys

# ── Auth ──────────────────────────────────────
# Disabled for local development. Set to "true" when PocketID is available.
AUTH_ENABLED=false

# ── LLM Provider ──────────────────────────────
# Required: at least one of these must be configured.
# OpenRouter (recommended): https://openrouter.ai/keys
OPENROUTER_API_KEY={{ valet_openrouter_api_key }}
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
COLLAPSE_MODEL=mistralai/mistral-small-24b-instruct-2501
MEMORY_MODEL=mistralai/mistral-small-24b-instruct-2501

# Ollama (fallback): http://localhost:11434
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

# ── APIs Externas ────────────────────────
OPENWEATHER_API_KEY={{ valet_openweather_api_key }}
GOOGLE_PLACES_API_KEY={{ valet_google_places_api_key }}
BRAVE_SEARCH_API_KEY={{ valet_brave_search_api_key }}

# ── Database ──────────────────────────────────
DATABASE_URL=/app/data/valet.db

# ── Logging ───────────────────────────────────
LOG_LEVEL=debug
