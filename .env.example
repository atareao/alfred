# Valet — local development configuration
# Copy to .env and fill in your keys.

# ── Server ──
HOST=0.0.0.0
PORT=3000

# ── Auth ──
# Disabled by default for local development. Set to true when PocketID is available.
AUTH_ENABLED=false
# AUTH_ISSUER_URL=http://localhost:8080
# AUTH_CLIENT_ID=
# AUTH_CLIENT_SECRET=
# AUTH_REDIRECT_URL=http://localhost:3000/auth/callback
# JWT_SECRET=change-me-in-production

# ── LLM provider (at least one required) ──
# OpenRouter (recommended): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
COLLAPSE_MODEL=mistralai/mistral-small-24b-instruct-2501
MEMORY_MODEL=mistralai/mistral-small-24b-instruct-2501

# Ollama fallback
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

# ── External APIs ──
OPENWEATHER_API_KEY=
GOOGLE_PLACES_API_KEY=
BRAVE_SEARCH_API_KEY=

# ── Database ──
DATABASE_URL=valet.db

# ── Logging ──
LOG_LEVEL=info

# ── Context collapse ──
COLLAPSE_THRESHOLD_TOKENS=2000

# ── Episodic memory ──
MEMORY_BATCH_TOKENS=2000
MEMORY_INACTIVITY_MINUTES=30
MEMORY_OVERLAP=2
MEMORY_POLL_INTERVAL_MINUTES=30

# ── RAG ──
RAG_BUDGET_TOKENS=2000
